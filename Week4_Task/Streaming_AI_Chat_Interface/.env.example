# Copy this file to .env.local and fill in ONE key.
# These are server-only. Never prefix them with NEXT_PUBLIC_ (that would ship them to the browser).

# Option 1: Google Gemini (free) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option 2: Claude — get a key at https://console.anthropic.com/settings/keys
# If this is set, the app uses Claude instead of Gemini.
ANTHROPIC_API_KEY=

# Optional: change the model
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL=claude-opus-5

# Optional: on a deployed site with no key, show the mock reply instead of an error
# CHAT_MOCK=1
